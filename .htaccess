# ========================================================
# FORSAKDA 26 - Apache Security & Routing Configuration
# ========================================================

# 1. Nonaktifkan Directory Browsing (Mencegah Directory Listing)
Options -Indexes

# 2. Blokir Akses ke File Sensitif (.sql, .env, .git, .log)
<FilesMatch "\.(sql|env|log|git|md|json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. HTTP Security Headers
<IfModule mod_headers.c>
    # Mencegah Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # Mencegah MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Mengaktifkan XSS Filter bawaan browser
    Header always set X-XSS-Protection "1; mode=block"
    # Batasi pengiriman referrer header
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Default Charset UTF-8
AddDefaultCharset UTF-8
